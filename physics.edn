;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": for financial leasing (ISIC 6491) an
;; asset-inspection robot documents leased-equipment condition before
;; funding, gated by the independent Leasing Governor. Physical work
;; modelled here: the inspection arm raising its ultrasonic-thickness /
;; camera head to the top of a leased machine, and the tensile check of a
;; coupon from a structural repair plate on a leased crane, whose steel is
;; declared S355.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-6491"
 :cases
 [{:id :inspection-head-to-machine-top
   :kind :manipulator
   :procedure "inspection arm raises its ultrasonic-thickness gauge and camera head from the stowed position to the top plate of the leased machine"
   :params {:l1-m 1.00 :l2-m 0.90 :m1-kg 10.0 :m2-kg 6.0
            :from [0.40 0.00] :to [1.20 1.20] :duration-s 3.0 :steps 500}
   :sweep {:param :payload-kg :values [1.0 2.5 4.0 6.0 8.0]}
   :quantity :peak-tau1-nm
   :limit {:max 250.0 :basis "estimate: continuous shoulder torque of a long-reach ~8 kg-payload inspection arm class"}
   :boundary {:lo 0.2 :hi 40.0}}
  {:id :repair-plate-grade-check
   :kind :material
   :procedure "tensile-test a coupon cut from a structural repair plate on a leased crane; the plate is declared S355 but may be a lower grade"
   :params {:length-m 0.10 :area-m2 1.0e-4 :youngs-modulus-pa 210.0e9 :hardening-pa 1.0e9
            :density-kg-m3 7850.0 :max-force-n 50000.0}
   :sweep {:param :yield-stress-pa :values [235.0e6 275.0e6 315.0e6 355.0e6 420.0e6]}
   :quantity :yield-force-n
   :limit {:min 35500.0 :basis "EN 10025-2 S355: minimum upper yield strength 355 MPa (nominal thickness <= 16 mm), times the 100 mm2 coupon section"}
   :boundary {:lo 200.0e6 :hi 420.0e6}}]}
